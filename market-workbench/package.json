{
  "name": "market-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "tsx --test src/server/backtest.test.ts src/server/marketData.test.ts src/server/paperTrading.test.ts src/server/paperSession.test.ts src/server/binanceMarketData.test.ts src/server/strategyScript.test.ts src/shared/indicators.test.ts src/shared/chartStudies.test.ts src/shared/strategyScript.test.ts src/shared/candleStream.test.ts",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@fontsource/ibm-plex-mono": "latest",
    "@fontsource/ibm-plex-sans": "latest",
    "@uiw/react-codemirror": "^4.25.12",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "cookie": "^2.0.2",
    "echarts": "^6.1.0",
    "express": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "latest"
  }
}
